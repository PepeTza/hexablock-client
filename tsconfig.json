{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@application/*": ["./src/application/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@frameworks/*": ["./src/frameworks/*"]
    }
  },
  // The Expo base list plus `admin/`, a separate web app with its own
  // tsconfig (setting `exclude` replaces the inherited list).
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "admin"
  ]
}
