# Store and check out text files with LF on every platform, so Windows
# checkouts do not show whole files as modified (see .editorconfig).
* text=auto eol=lf

# Binary assets: never convert line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.ogg binary
