{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lets the lint rule test import eslint-boundaries.js with its JSDoc types.
    "allowJs": true,
    "types": ["vite/client"],
    // Same aliases as vite.config.ts and as the app (D-19).
    "paths": {
      "@domain/*": ["../src/domain/*"],
      "@application/*": ["../src/application/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "eslint-boundaries.js",
    "eslint-boundaries.test.ts"
  ]
}
