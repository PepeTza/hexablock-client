{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Same alias as vite.config.ts and as the app (D-19).
    "paths": {
      "@domain/*": ["../src/domain/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
